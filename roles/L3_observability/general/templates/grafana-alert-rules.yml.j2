apiVersion: 1

groups:
  - name: nist_hardening_alerts
    rules:
      # --- ServiceDown: health probe fails for > N minutes ---
      - alert: ServiceDown
        expr: probe_success{job="blackbox-http"} == 0
        for: {{ observability_alert_service_down_minutes }}m
        labels:
          severity: critical
          layer: l3-observability
        annotations:
          summary: "Service {{ '{{ $labels.instance }}' }} is DOWN"
          description: "Blackbox probe to {{ '{{ $labels.instance }}' }} has been failing for more than {{ observability_alert_service_down_minutes }} minutes."

      # --- HighCPU: CPU utilization > threshold for 5 min ---
      - alert: HighCPU
        expr: |
          100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > {{ observability_alert_cpu_threshold }}
        for: 5m
        labels:
          severity: warning
          layer: l3-observability
        annotations:
          summary: "High CPU on {{ '{{ $labels.instance }}' }}"
          description: "CPU usage has exceeded {{ observability_alert_cpu_threshold }}% for more than 5 minutes (current: {{ '{{ $value }}' }}%)."

      # --- HighMemory: memory utilization > threshold for 5 min ---
      - alert: HighMemory
        expr: |
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > {{ observability_alert_memory_threshold }}
        for: 5m
        labels:
          severity: warning
          layer: l3-observability
        annotations:
          summary: "High memory usage on {{ '{{ $labels.instance }}' }}"
          description: "Memory usage has exceeded {{ observability_alert_memory_threshold }}% for more than 5 minutes (current: {{ '{{ $value }}' }}%)."

      # --- DiskPressure: disk usage > threshold ---
      - alert: DiskPressure
        expr: |
          (node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"} - node_filesystem_free_bytes{fstype!~"tmpfs|overlay|squashfs"})
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"} * 100 > {{ observability_alert_disk_threshold }}
        for: 2m
        labels:
          severity: critical
          layer: l3-observability
        annotations:
          summary: "Disk pressure on {{ '{{ $labels.instance }}' }} ({{ '{{ $labels.mountpoint }}' }})"
          description: "Filesystem {{ '{{ $labels.mountpoint }}' }} on {{ '{{ $labels.instance }}' }} has exceeded {{ observability_alert_disk_threshold }}% usage (current: {{ '{{ $value }}' }}%)."

      # --- CertExpiry: TLS certificate expiring soon ---
      - alert: CertExpiry
        expr: probe_ssl_earliest_cert_expiry - time() < {{ observability_alert_cert_expiry_days }} * 86400
        for: 1m
        labels:
          severity: warning
          layer: l3-observability
        annotations:
          summary: "TLS certificate expiring soon on {{ '{{ $labels.instance }}' }}"
          description: "TLS certificate for {{ '{{ $labels.instance }}' }} expires in less than {{ observability_alert_cert_expiry_days }} days."
