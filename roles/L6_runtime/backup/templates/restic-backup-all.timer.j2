[Unit]
Description=Daily Restic backup - {{ ansible_hostname }}
Requires=restic-backup-all.service

[Timer]
{# brain=nightly, muscle=hourly — schedule varies by node role #}
{% if 'brain' in group_names %}
OnCalendar={{ restic_backup_time_by_group.brain }}
{% elif 'muscle' in group_names %}
OnCalendar={{ restic_backup_time_by_group.muscle }}
{% elif 'local' in group_names %}
OnCalendar={{ restic_backup_time_by_group.local }}
{% else %}
OnCalendar=02:00
{% endif %}
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
