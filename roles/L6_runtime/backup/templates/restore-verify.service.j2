# Jinja2 template: systemd service unit for restore verification.
# Generates: backup-restore-verify-{{ _app_name }}.service
# The runner restores the latest snapshot into a scratch target, smoke-checks
# the payload, records evidence and propagates failure (D13/VERIFY-001..004).

[Unit]
Description=Restore verification for {{ _app_name }}
Documentation=man:restic(1)
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/backup-restore-verify-{{ _app_name }}.sh
EnvironmentFile=-/etc/restic/env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=journal
StandardError=journal
