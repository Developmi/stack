# Jinja2 template: systemd timer unit for per-app database backups
# Generates: backup-db-{{ _app_name }}.timer
# Schedule derived from profile.backup.schedule (ADR-03)

[Unit]
Description=Backup timer for database {{ _app_name }}
Requires=backup-db-{{ _app_name }}.service

[Timer]
{# brain=nightly, muscle=hourly - schedule varies by node role #}
OnCalendar={{ _p.backup.schedule }}
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
