# Jinja2 template: systemd service unit for Tier1 image-discovered backups.
# Generates: backup-tier1.service
# The runner discovers postgres/clickhouse/redis-valkey containers by image and
# streams logical dumps into restic (TIER-001/D14, ENGINE-005).

[Unit]
Description=Tier1 image-discovered database backup
Documentation=man:restic(1)
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/backup-tier1.sh
EnvironmentFile=-/etc/restic/env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=journal
StandardError=journal
