# ==============================================================================
# CADDY INGRESS STACK - Reverse Proxy with Coraza WAF
# ==============================================================================
services:
  caddy:
    image: {{ caddy_image }}
    container_name: caddy-waf
    restart: unless-stopped
    read_only: true
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
      - "443:443/udp"
    networks:
      - {{ shared_network_name }}
    volumes:
      - {{ app_base_dir }}/ingress/caddy-data:/data
      - {{ app_base_dir }}/ingress/caddy-config:/config
      - /srv/caddy/certs:/etc/caddy/certs:ro
      - {{ app_base_dir }}/ingress/Caddyfile:/etc/caddy/Caddyfile:ro
      # D2 (caddy-waf-ui contract) | Shared ui-managed overlay directory, READ-ONLY
      # for Caddy. The role pre-creates it plus the per-slug placeholder files
      # (waf = baseline DetectionOnly, ip-rules = empty) so Caddy boots even
      # before the UI writes; after the first UI write the files are UI-owned.
      # Platform deployments: run the caddy-waf-ui container as UID/GID
      # {{ caddy_user_uid }}:{{ caddy_user_gid }} so it can write overlays,
      # /backups and read the audit log (contract §5/§7).
      - {{ app_base_dir }}/ingress/ui-managed:/etc/caddy/ui-managed:ro
    tmpfs:
      - /tmp:size=64m,noexec,nosuid,nodev
    user: "{{ caddy_user_uid }}:{{ caddy_user_gid }}"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "1G"
        reservations:
          memory: "512M"
    healthcheck:
      test: ["CMD-SHELL", "pgrep caddy || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  {{ shared_network_name }}:
    external: true
