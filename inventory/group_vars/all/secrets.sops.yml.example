---
# =============================================================================
# SECRETS SOPS EXAMPLE - public template twin (D10)
# =============================================================================
# Ansible does NOT read this file. It is the template for the real,
# SOPS-encrypted file inventory/group_vars/all/secrets.sops.yml:
#
#   cp inventory/group_vars/all/secrets.sops.yml.example \
#      inventory/group_vars/all/secrets.sops.yml
#   make sops-encrypt
#   # or explicitly: make sops-encrypt SOPS_FILE=inventory/group_vars/all/secrets.sops.yml
#
# Workflow (replaces the old Ansible Vault workflow):
#   1. Generate the age keypair and back it up OFFLINE:
#        age-keygen -o age/keys.txt
#   2. Copy .sops.yaml.example to .sops.yaml and replace age1<PLACEHOLDER>
#      with your age public key. NEVER commit .sops.yaml (gitignored, 2.7).
#   3. Replace every placeholder below (none of them is real) with REAL
#      values - ONLY in your private clone / local copy. The committed
#      example must keep generic slugs (client_primary, admin@example.invalid,
#      cluster_primary).
#   4. Encrypt in place:                 make sops-encrypt
#   5. Edit later:                       make sops-edit
#      View:                             make sops-view
#      Extra recipients:                 sops updatekeys secrets.sops.yml
#
# The real file is gitignored (2.7): inventory/group_vars/all/secrets.sops.yml
# must NEVER be committed, encrypted or not (public template hermeticity, D10).
#
# Key hygiene (decouple-manager-sops design D2/D3):
#   - The tailscale trio (tailscale_auth_key, tailscale_acl_key,
#     tailscale_acl_client_id) STAYS in the Ansible vault
#     (inventory/group_vars/all/secrets.yml) until key expiry, then is
#     retired (OPERATIONS_RUNBOOK §7.4). Do NOT add it here.
#   - Manager edge keys live in managers/portainer.sops.yml - never here.
#   - Dead keys (the old manager url/username/password/server_url set and
#     observability_network_name) were removed: zero consumers
#     (see OPERATIONS_RUNBOOK §1.3).
# =============================================================================


# =============================================================================
# TAILSCALE - ACL CONFIG (non-secret, may stay plaintext in secrets.sops.yml)
# =============================================================================

# Tailnet name, e.g. "mycorp.ts.net". Used to build the ACL API URL.
# Used by playbooks/l2/hardening.yml:103 and playbooks/ops/local-devices.yml:60.
tailscale_tailnet: "tailnet.example.invalid"

# Optional ACL groups: map of group name -> member list.
# Rendered into the "groups" section of the ACL JSON.
# Used by roles/L2_compliance/general/templates/tailscale/tailscale-acls.json.j2:78.
# Example: { "group:devs": ["alice@example.com", "bob@example.com"] }
tailscale_acl_groups: {}

# Sources allowed to SSH into tag:brain / tag:muscle (port 22).
# Empty list = no extra rule. Accepts users, groups or autogroup.
# Used by roles/L2_compliance/general/templates/tailscale/tailscale-acls.json.j2:6.
tailscale_acl_automation_sources: ["admin@example.invalid"]

# Sources allowed to reach management UIs on the brain node
# (Portainer 9000/9443, Grafana 3000, VictoriaMetrics 8428, Loki 3100).
# Used by roles/L2_compliance/general/templates/tailscale/tailscale-acls.json.j2:8.
tailscale_acl_admin_ui_sources: ["admin@example.invalid"]

# Sources that get emergency SSH access (same rule as automation,
# independent list so it can be kept empty).
# Used by roles/L2_compliance/general/templates/tailscale/tailscale-acls.json.j2:7.
tailscale_acl_breakglass_sources: ["admin@example.invalid"]


# =============================================================================
# SSH ACCESS
# =============================================================================

# Public keys deployed to /home/<user>/.ssh/authorized_keys per user.
# Keys are PUBLIC - the example shows the structure; put your real keys in SOPS.
# Users created in playbooks/ops/bootstrap.yml:149 and
# roles/L2_compliance/general/tasks/user_hardening/deploy_keys.yml:13.
# All three users are required (asserted by deploy_keys.yml).
ssh_public_keys:
  automation: "ssh-ed25519 AAAA...PLACEHOLDER automation@example.invalid"
  dev_admin: "ssh-ed25519 AAAA...PLACEHOLDER devadmin@example.invalid"
  breakglass: "ssh-ed25519 AAAA...PLACEHOLDER breakglass@example.invalid"


# =============================================================================
# CADDY - ACME
# =============================================================================

# Email used by Caddy for ACME (Let's Encrypt) account registration.
# Used by roles/L4_networking/caddy/templates/Caddyfile.example.j2:38.
# Optional - only relevant if a domain is NOT behind a Cloudflare origin cert.
caddy_acme_email: "admin@example.invalid"


# =============================================================================
# CADDY - CLOUDFLARE ORIGIN CERTIFICATES
# =============================================================================

# Static TLS certs (Cloudflare origin certificates) served by Caddy.
# Key format: client_<name> - the <name> MUST match the `client` field of the
# ingress_services entries that use this cert.
# Deployed to /etc/caddy/certs/<name>/fullchain.pem + privkey.pem.
# Used by roles/L4_networking/caddy/tasks/certs.yml:47 (assert) and :96/:110 (deploy).
# Required for every `client` referenced in ingress_services.
# Replace PLACEHOLDER_CERT / PLACEHOLDER_KEY with the real PEM blocks.
cloudflare_origin_certs:
  client_primary:
    cert: "PLACEHOLDER_CERT"
    key: "PLACEHOLDER_KEY"


# =============================================================================
# INGRESS SERVICES (routing catalog)
# =============================================================================

# Security profiles referenced by ingress_services[*].security_profile.
# Each profile toggles the WAF (Coraza) and the VPN-only restriction.
# Used by roles/L4_networking/caddy/tasks/main.yml:27 and
# roles/L4_networking/caddy/templates/Caddyfile.example.j2:142.
# Required by L4 deployment (preflight asserts it is defined).
ingress_security_profiles:

  public_waf:
    import_waf: true
    import_vpn_only: false

  basicauth:
    import_waf: false
    import_vpn_only: false

  vpn_only:
    import_waf: true
    import_vpn_only: true

# Routing catalog: one entry per domain Caddy must serve.
# Rendered by roles/L4_networking/caddy/templates/Caddyfile.example.j2:135,
# preflight-checked in roles/L4_networking/caddy/tasks/main.yml:22.
# Overrides the default [] in inventory/group_vars/all/main.yml:185.
# Required by L4 deployment - an empty catalog aborts deployment.
# Add one entry per domain; target_group examples: "brain" | "muscle" |
# "muscle-1" | ["muscle-1", "brain-1"].
ingress_services:

  - name: app-example                  # label only - used in logs/warnings
    domain: app.example.invalid        # required - public hostname
    upstream: app:8080                 # required - container:port
    client: client_primary             # required - cert source; MUST exist in
                                       # cloudflare_origin_certs (path /etc/caddy/certs/<client>/)
    target_group: brain              # required - routing filter (see above)
    security_profile: public_waf       # required - MUST exist in ingress_security_profiles
    tls_client_auth: cloudflare        # optional - enables Cloudflare Origin Pull mTLS
    proxy_headers:
      standard: true                   # forward Host + X-Real-IP to the backend
      websocket: true                  # true = bypass WAF for WebSocket upgrades
    headers:
      X-Custom-Header: "PLACEHOLDER_HEADER_VALUE"


# =============================================================================
# RESTIC BACKUPS (R2 + TELEGRAM)
# =============================================================================

# Cloudflare R2 credentials for the Restic backup repositories (full bucket).
# Used by roles/L6_runtime/backup/defaults/main.yml:30 (endpoint URL),
# templates/restic-env.j2:9-12 and tasks/restic_backup.yml:32.
# Required by the backup role.
restic_r2_account_id: "PLACEHOLDER_R2_ACCOUNT_ID"
restic_r2_access_key_id: "PLACEHOLDER_R2_ACCESS_KEY_ID"
restic_r2_secret_access_key: "PLACEHOLDER_R2_SECRET_ACCESS_KEY"

# One Restic repository password PER HOST.
# Naming convention: restic_password_<hostname with "-" replaced by "_">.
# Resolved dynamically in roles/L6_runtime/backup/tasks/credentials.yml:20.
# NOTE: keys with a numeric host suffix (restic_password_node_1) are covered by
# the extended encrypted_regex in .sops.yaml.example
# (`_password(_[a-zA-Z0-9_]+)?$`) - verify before the first encryption
# (design verification step 2).
# Required by the backup role on each host.
restic_password_node_1: "REPLACE_WITH_RESTIC_PASSWORD"
restic_password_node_2: "REPLACE_WITH_RESTIC_PASSWORD"
restic_password_node_3: "REPLACE_WITH_RESTIC_PASSWORD"

# Telegram notification bot for backup reports.
# Used by roles/L6_runtime/backup/tasks/notify.yml:12 and templates/restic-env.j2:13-14.
# Required by the backup role.
restic_telegram_bot_token: "PLACEHOLDER_TELEGRAM_BOT_TOKEN"
restic_telegram_chat_id: "PLACEHOLDER_TELEGRAM_CHAT_ID"

# R2 credentials for the backup TIMERS only.
# Separate limited IAM key - only needs s3:PutObject on the db/ prefix.
# Account id is shared with the Restic endpoint construction.
# The vault_ prefix is historical (key names are grep-verified live keys).
# Used by roles/L6_runtime/backup/tasks/timers.yml:28-30.
# Required by the database backup timers.
backup_r2_account_id: "PLACEHOLDER_R2_ACCOUNT_ID"
vault_backup_r2_access_key_id: "PLACEHOLDER_R2_ACCESS_KEY_ID"
vault_backup_r2_secret_access_key: "PLACEHOLDER_R2_SECRET_ACCESS_KEY"


# =============================================================================
# OBSERVABILITY (GRAFANA)
# =============================================================================
# NOTE: observability_network_name is NOT a secret - it is defined in
# roles/L3_observability/general/defaults/main.yml:13. Its old vault copy was
# dropped (redundant with the role default; operator verified the vault value
# matched `observability_net` before the drop - design D3).

# IP used inside the stack (HOST_IP). Use the node's Tailscale IP so
# exporters can reach the monitoring services over the mesh.
# Used by roles/L3_observability/general/templates/observability-stack.env.j2:4.
observability_stack_host_ip: "PLACEHOLDER_NODE_TAILSCALE_IP"

# Grafana admin credentials and public URL.
# Asserted as required in roles/L3_observability/general/tasks/stack.yml:57-65,
# rendered in templates/observability-stack.env.j2:1-3.
observability_grafana_admin_user: "admin@example.invalid"
observability_grafana_admin_password: "REPLACE_WITH_STRONG_PASSWORD"
observability_grafana_root_url: "https://grafana.example.invalid"


# =============================================================================
# GITHUB CONTAINER REGISTRY
# =============================================================================

# Namespace of the container images (images are pulled from this registry).
# Consumed via inventory/group_vars/all/images.yml:12 (image_namespace).
# Required for L4 (Caddy WAF image) and L6 deployments.
vault_image_namespace: "ghcr.io/example-org"

# GitHub user that owns (or can read) the image namespace.
# Consumed via inventory/group_vars/all/images.yml:22 (github_username).
# Required for L4/L6 deployments.
vault_github_username: "example-github-user"

# GitHub Personal Access Token (read:packages) used to log in to the registry.
# Used by roles/L4_networking/caddy/tasks/caddy.yml:377 (docker login) and
# validated in playbooks/ops/local-devices.yml:38.
# Required for L4/L6 deployments.
vault_github_token: "REPLACE_WITH_GITHUB_PAT"


# =============================================================================
# MISC (OPTIONAL)
# =============================================================================

# CrowdSec console enrollment key. Only needed if the CrowdSec agents
# must report to a console. Used by roles/L2_compliance/nist_800_53/si-4/tasks/agent.yml:205.
# Optional - skip if you do not use the CrowdSec console.
# crowdsec_console_key: "REPLACE_WITH_CROWDSEC_CONSOLE_KEY"
