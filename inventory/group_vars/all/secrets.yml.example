---
# =============================================================================
# ANSIBLE VAULT - PRODUCTION SECRETS
# =============================================================================
# Secrets only.
# Non-secret defaults belong in group_vars/all/images.yml.
# =============================================================================


# =============================================================================
# AUTHENTICATION & TOKENS
# =============================================================================

# AC-3: vault_image_* values feed into images.yml via vault_image_* vars
vault_image_namespace: "ghcr.io/your-org"
vault_github_username: "your-github-username"

vault_github_token: "GITHUB_TOKEN"

tailscale_auth_key: "tskey-client-XXXXXXXXXXXXXXXX"

portainer_edge_keys_by_node:
  brain-1: "PORTAINER_EDGE_KEY_BRAIN_1"
  muscle-1: "PORTAINER_EDGE_KEY_MUSCLE_1"

# Optional
# crowdsec_console_key: "CROWDSEC_CONSOLE_KEY"


# =============================================================================
# SSH USER HARDENING - Public Keys (Phase 6)
# =============================================================================
# Replace each value with the actual ed25519 public key.
# These are PUBLIC keys - safe to commit in the example file.
# The vault (secrets.yml) holds the actual keys; this shows the schema.

ssh_public_keys:
  dev_admin: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... devadmin@machine"
  automation: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... ansible@machine"
  breakglass: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... breakglass@offline"


# =============================================================================
# OBSERVABILITY STACK
# =============================================================================

observability_network_name: "observability_net" `pragma: allowlist secret`
observability_stack_host_ip: "100.00.0.00" `pragma: allowlist secret`

observability_grafana_admin_user: "admin@example.com" `pragma: allowlist secret`
observability_grafana_admin_password: "EXAMPLE_PASSWORD" `pragma: allowlist secret`
observability_grafana_root_url: "https://grafana.example.com" `pragma: allowlist secret`


# =============================================================================
# TAILSCALE ACL AUTOMATION
# =============================================================================

tailscale_acl_key: "tskey-client-YYYYYYYYYYYY"

tailscale_acl_client_id: "TAILSCALE_OAUTH_CLIENT_ID"

tailscale_tailnet: "example.ts.net"

tailscale_acl_automation_sources: []
tailscale_acl_admin_ui_sources: []
tailscale_acl_breakglass_sources: []

tailscale_acl_groups: {}


# =============================================================================
# TLS / ACME
# =============================================================================

caddy_acme_email: "ops@example.com"


# =============================================================================
# CLOUDFLARE ORIGIN CERTIFICATES
# =============================================================================
# ADR-03 (v6.0.0): Key format is client_<name> - matches the tenant directory slug.
# Legacy account_a_example_com keys are deprecated.
# ingress_services[*].client drives cert resolution (cert_name removed).
# =============================================================================

cloudflare_origin_certs:

  client_example:
    cert: | `pragma: allowlist secret`
      -----BEGIN CERTIFICATE-----
      REPLACE_WITH_CERTIFICATE
      -----END CERTIFICATE-----

    key: | `pragma: allowlist secret`
      -----BEGIN PRIVATE KEY----- `pragma: allowlist secret`
      REPLACE_WITH_PRIVATE_KEY
      -----END PRIVATE KEY-----

  # client_secondary:
  #   cert: | `pragma: allowlist secret`
  #     -----BEGIN CERTIFICATE-----
  #     ...
  #     -----END CERTIFICATE-----
  #
  #   key: | `pragma: allowlist secret`
  #     -----BEGIN PRIVATE KEY----- `pragma: allowlist secret`
  #     ...
  #     -----END PRIVATE KEY-----


# =============================================================================
# INGRESS SECURITY PROFILES
# =============================================================================

ingress_security_profiles:

  public_waf:
    import_waf: true
    import_vpn_only: false

  vpn_only:
    import_waf: true
    import_vpn_only: true

  public_open:
    import_waf: false
    import_vpn_only: false


# =============================================================================
# INGRESS ROUTING
# =============================================================================
# Keep encrypted.
#
# target_group:
# - brain  = management / observability
# - muscle = application workloads
#
# security_profile:
# - public_waf
# - vpn_only
# - public_open
# =============================================================================

ingress_services:

  # ADR-03 (v6.0.0): Every entry requires client: field. cert_name removed.
  # client drives cert path: /etc/caddy/certs/<client>/fullchain.pem

  - name: n8n
    domain: n8n.example.com
    upstream: n8n:5678
    client: client_example
    target_group: muscle
    security_profile: public_waf
    tls_client_auth: cloudflare
    proxy_headers:
      standard: false
      websocket: true
    x_frame_options: SAMEORIGIN
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob:;
      connect-src 'self' wss:;
      font-src 'self' data:;
      worker-src 'self' blob:;
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  - name: metabase
    domain: analytics.example.com
    upstream: metabase:3000
    client: client_example
    target_group: muscle
    security_profile: public_waf
    proxy_headers:
      standard: false
      websocket: false
    x_frame_options: SAMEORIGIN
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self';
      font-src 'self' data: https:;
      media-src 'self' blob:;
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  - name: twenty
    domain: crm.example.com
    upstream: twenty:3000
    client: client_example
    target_group: muscle
    security_profile: public_waf
    proxy_headers:
      standard: true
      websocket: true
    x_frame_options: DENY
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self' wss:;
      font-src 'self' data:;
      worker-src 'self' blob:;
      media-src 'self';
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  - name: chatwoot
    domain: chat.example.com
    upstream: chatwoot:3000
    client: client_example
    target_group: muscle
    security_profile: public_waf
    proxy_headers:
      standard: true
      websocket: true
    x_frame_options: DENY
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self' wss: https:;
      font-src 'self' data:;
      media-src 'self' blob:;
      worker-src 'self' blob:;
    permissions_policy: >-
      camera=(self), microphone=(self), geolocation=()

  - name: uptime-kuma
    domain: status.example.com
    upstream: uptime-kuma:3001
    client: client_example
    target_group: brain
    security_profile: vpn_only
    proxy_headers:
      standard: false
      websocket: false
    x_frame_options: DENY
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self';
      font-src 'self';
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  - name: portainer
    domain: portainer.example.com
    upstream: portainer:9000
    client: client_example
    target_group: brain
    security_profile: vpn_only
    proxy_headers:
      standard: false
      websocket: true
    x_frame_options: DENY
    referrer_policy: strict-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self' wss:;
      font-src 'self' data:;
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  - name: grafana
    domain: grafana.example.com
    upstream: grafana:3000
    client: client_example
    target_group: brain
    security_profile: vpn_only
    proxy_headers:
      standard: false
      websocket: true
    x_frame_options: SAMEORIGIN
    referrer_policy: strict-origin-when-cross-origin
    csp: >-
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval';
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: blob: https:;
      connect-src 'self' wss:;
      font-src 'self' data:;
      frame-src 'self';
    permissions_policy: >-
      camera=(), microphone=(), geolocation=()

  # Portainer API credentials
  portainer_url: "https://100.00.00.0:9443"
  portainer_username: "admin"
  portainer_password: "password"

# =============================================================================
# BACKUP - Restic + R2
# =============================================================================
# R2 uses S3-compatible credentials.
# Each host has its own Restic repository password.
# =============================================================================

# Cloudflare R2 (Restic - full bucket access for L5 backup role)
restic_r2_account_id: "CLOUDFLARE_ACCOUNT_ID"
restic_r2_access_key_id: "R2_ACCESS_KEY_ID"
restic_r2_secret_access_key: "R2_SECRET_ACCESS_KEY"


# =============================================================================
# BACKUP - L5 timer R2 credentials
# =============================================================================
# SEPARATE IAM policy - only needs s3:PutObject to the db/ prefix.
# Uses the same account_id to construct the endpoint URL.
# =============================================================================

# R2 account ID shared between Restic and timer endpoints
backup_r2_account_id: "CLOUDFLARE_ACCOUNT_ID"

# Timer-specific access key (limited IAM - db/* PutObject only)
vault_backup_r2_access_key_id: "TIMER_R2_ACCESS_KEY_ID"
vault_backup_r2_secret_access_key: "TIMER_R2_SECRET_ACCESS_KEY"

# Restic repository passwords
restic_password_brain_1: "RESTIC_PASSWORD_BRAIN_1"
restic_password_muscle_1: "RESTIC_PASSWORD_MUSCLE_1"
restic_password_muscle_2: "RESTIC_PASSWORD_MUSCLE_2"

# Telegram notifications
restic_telegram_bot_token: "TELEGRAM_BOT_TOKEN"
restic_telegram_chat_id: "TELEGRAM_CHAT_ID"
